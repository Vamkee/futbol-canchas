# ─────────────────────────────────────────────
# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...TU_ANON_KEY

# Solo uso server-side (NUNCA exponer en el cliente). Necesario para tareas
# admin que requieren bypass de RLS (ej. cron de expiración de reservas).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...TU_SERVICE_ROLE_KEY

# ─────────────────────────────────────────────
# WhatsApp del negocio (con código de país, sin + ni espacios)
# Ejemplo Colombia: 573001234567
# ─────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567

# ─────────────────────────────────────────────
# Seguridad
# ─────────────────────────────────────────────
# Secreto par proteger el endpoint cron de expiración de reservas.
# Generar con: openssl rand -hex 32
CRON_SECRET=

# Base URL (usado por Supabase Auth para redirecciones)
NEXT_PUBLIC_SITE_URL=http://localhost:3000